# DevConnect Frontend — Environment Variables
# Copy this file to .env and fill in your values

# API base URL — with Vite proxy, this can be left as /api/v1 for local dev
# For production (Vercel), set to your deployed backend URL:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_API_URL=/api/v1

# Socket.io server URL — empty string means same origin (works with Vite proxy)
# For production set to your backend URL:
# VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=
